# Copy to backend/.env for local development. NEVER commit the real .env.
PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/boardingbook?retryWrites=true&w=majority

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend address(es), comma-separated. Used for CORS and links in emails.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Email (Resend). Without RESEND_API_KEY, emails are logged instead of sent.
# EMAIL_FROM must use a domain verified in Resend to reach any recipient.
RESEND_API_KEY=
EMAIL_FROM=BoardingBook <onboarding@resend.dev>

